     1                                  [bits 16]
     2                                  [org 0x7C00]
     3                                  
     4                                  ; Compile time constants.
     5                                  
     6                                  STACK_SIZE equ 0xAAAA
     7                                  STACK_BOTTOM equ 0x8000
     8                                  
     9                                  SCREEN_WIDTH equ 320
    10                                  SCREEN_HEIGHT equ 200
    11                                  RANGE equ (SCREEN_HEIGHT * SCREEN_WIDTH) / 2
    12                                  
    13                                  BALL_DIM equ 5
    14                                  BALL_START_X equ (SCREEN_WIDTH - BALL_DIM) / 2
    15                                  BALL_START_Y equ (SCREEN_HEIGHT - BALL_DIM) / 2
    16                                  PLAYER_PADDLE_OFFSET equ 20
    17                                  ENEMY_PADDLE_OFFSET equ 319 - PLAYER_PADDLE_OFFSET - PLAYER_PADDLE_WIDTH
    18                                  PLAYER_PADDLE_WIDTH equ 5
    19                                  PLAYER_PADDLE_HEIGHT equ 50
    20                                  
    21                                  
    22                                  
    23                                  ; ~~~~~ CODE SECTION ~~~~~
    24                                  
    25                                  section .text
    26                                  
    27                                  
    28                                  ; ~~~~~ SETUP STACK SPACE ~~~~~
    29                                  ; Setup stack for pushing/popping and function calling.
    30                                  setup_stack:
    31                                  	; Set up stack space by setting stack segment register and stack pointer register.
    32 00000000 B80080                  	mov ax, STACK_BOTTOM
    33 00000003 8ED0                    	mov ss, ax
    34 00000005 BCAAAA                  	mov sp, STACK_SIZE
    35                                  
    36                                  
    37                                  main:
    38                                  	; ~~~~~ SETUP VIDEO ~~~~~
    39                                  	; 320x200 8 bit color graphical mode.
    40                                  	; Memory adressing is done using a segment and offset.
    41                                  	; Video memory starts at segment 0xA000.
    42                                  	; Video memory is 1 byte per pixel, column major, index from top left.
    43 00000008 B81300                  	mov ax, 0x13
    44 0000000B CD10                    	int 0x10
    45                                  
    46                                  	; ~~~~~ 16 BIT REGISTERS AND GAME VARIABLE MAP ~~~~~
    47                                  
    48                                  	; Registers
    49                                  	; ax, bx, cx, dx - general purpose, 16 bit or byte adressable, supports immediate mov
    50                                  	; si, di, bp, sp - general purpose, 16 bit, supports immediate mov
    51                                  	; Note sp is reserved for stack usage.
    52                                  
    53                                  	; Game variables
    54                                  	; Left paddle vertical position : al 
    55                                  	; Right paddle vertical position : ah
    56                                  	; Ball velocity x : bl
    57                                  	; Ball velocity y : bh
    58                                  	; Ball position x : si
    59                                  	; Ball position y : di 
    60                                  	; Left paddle score : cl
    61                                  	; Right paddle score : ch
    62                                  	; Leaves dx (dl, dh), bp free
    63                                  
    64                                  
    65                                  
    66                                  	; ~~~~~ INITILIZE GAME VARIABLES ~~~~~
    67                                  
    68                                  	; ~~~~~ INITILIZE BALL VELOCITY ~~~~~~
    69                                  	; Use the gen rand velocity function to generate a random velocity for both ball x and y.
    70                                  	; gen_rand_velocity generates to the dl register.
    71 0000000D E87501                  	call gen_rand_velocity
    72 00000010 88E3                    	mov bl, ah
    73 00000012 E87001                  	call gen_rand_velocity
    74 00000015 88E7                    	mov bh, ah
    75                                  
    76                                  	; ~~~~~ INITILIZE PADDLES ~~~~~
    77                                  	; Both paddles start at 1, at the top, just after the border.
    78 00000017 B80101                  	mov ax, 0x0101
    79                                  
    80                                  	; ~~~~~ INITILIZE BALL POSITION ~~~~~	
    81                                  	; Ball position starts at the center.
    82 0000001A BE9D00                  	mov si, BALL_START_X
    83 0000001D BF6100                  	mov di, BALL_START_Y
    84                                  
    85                                  	; ~~~~~ INITILIZE PADDLE SCORES ~~~~~
    86 00000020 31C9                    	xor cx, cx ; one byte register clear
    87                                  
    88                                  
    89                                  
    90                                  	; ~~~~~ MAIN GAME LOOP ~~~~~
    91                                  	.game_loop:
    92                                  		; ~~~~~ BEEPING TEST ~~~~~
    93                                  		; Beep test.
    94                                  		; push ax
    95                                  		; mov ah, 0x0E
    96                                  		; mov al, 7
    97                                  		; int 0x10
    98                                  		; pop ax
    99                                  
   100                                  
   101                                  
   102                                  		; ~~~~~ GAME INPUT LOGIC ~~~~~
   103                                  		; Start paddle input, use non-blocking poll of keyboard presses.
   104                                  		; ah = key scan code, zf = 0 if key presed. al = ascii char, ax = 0 if no key pressed.
   105 00000022 50                      		push ax
   106 00000023 B401                    		mov ah, 0x01
   107 00000025 CD16                    		int 0x16
   108                                  
   109 00000027 7501                    		jnz SHORT .pop_endif
   110 00000029 58                      			pop ax 
   111                                  		.pop_endif:
   112                                  
   113 0000002A 741D                    		jz SHORT .endif
   114                                  			; If key detected, redo with blocking input. As non-blocking seems to miss keys.
   115 0000002C 30E4                    			xor ah, ah
   116 0000002E CD16                    			int 0x16
   117                                  			; Move scan code to dh, so ax can be popped from the stack.
   118 00000030 88E6                    			mov dh, ah
   119 00000032 58                      			pop ax
   120                                  
   121                                  			; Test if 0x48 (up) scancode detected.
   122 00000033 80FE48                  			cmp dh, 0x48
   123 00000036 7506                    			jne SHORT .if_down
   124                                  				; Block movment if paddle is too high.
   125 00000038 3C04                    				cmp al, 4
   126 0000003A 7602                    				jbe SHORT .if_down
   127 0000003C 2C04                    					sub al, 4
   128                                  			; Test if 0x50 (down) scancode detected.
   129                                  			.if_down:
   130 0000003E 80FE50                  			cmp dh, 0x50
   131 00000041 7506                    			jne SHORT .endif
   132                                  				; Block movement if paddle is too low.
   133 00000043 3C91                    				cmp al, 199 - PLAYER_PADDLE_HEIGHT - 4
   134 00000045 7302                    				jae SHORT .endif
   135 00000047 0404                    					add al, 4
   136                                  		.endif:
   137                                  
   138                                  
   139                                  		
   140                                  		; ~~~~~ GAME PHYSICS LOGIC ~~~~~
   141                                  
   142                                  		; ~~~~~ BALL POSITION UPDATE ~~~~~
   143                                  		; Need to upgrade 8 bit register to 16 bit in order to add together.
   144                                  		; movsx is a sign-preserving mov.
   145                                  		; X component.
   146 00000049 31D2                    		xor dx, dx
   147 0000004B 0FBED3                  		movsx dx, bl
   148 0000004E 01D6                    		add si, dx
   149                                  		; Y component.
   150 00000050 31D2                    		xor dx, dx 
   151 00000052 0FBED7                  		movsx dx, bh
   152 00000055 01D7                    		add di, dx
   153                                  
   154                                  		; ~~~~~ BALL COLLISION DETECTION ~~~~~
   155                                  
   156                                  		; ~~~~~ PLAYER SCORING ZONE ~~~~~
   157                                  		; Detect if the right side of the ball is to the left of the left edge of the left paddle.
   158                                  		; This indicates the enemy has scored.
   159 00000057 83FE0F                  		cmp si, PLAYER_PADDLE_OFFSET - BALL_DIM
   160 0000005A 7305                    		jae SHORT .end_if_left_wall
   161                                  			; Enemy has scored.
   162 0000005C FEC5                    			inc ch
   163 0000005E E98201                  			jmp show_score
   164                                  		.end_if_left_wall:
   165                                  
   166                                  		; ~~~~~ ENEMY SCORING ZONE ~~~~~
   167                                  		; Detect if the left side of the ball is to the right of the right edge of the right paddle.
   168 00000061 81FE2601                		cmp si, 319 - PLAYER_PADDLE_OFFSET - PLAYER_PADDLE_WIDTH
   169 00000065 7605                    		jbe SHORT .end_if_right_wall
   170                                  			; Player has scored.
   171 00000067 FEC1                    			inc cl
   172 00000069 E97701                  			jmp show_score
   173                                  		.end_if_right_wall:
   174                                  
   175                                  		; ~~~~~ LEFT PADDLE ~~~~~
   176 0000006C 50                      		push ax
   177 0000006D 30E4                    		xor ah, ah
   178 0000006F 89C5                    		mov bp, ax
   179 00000071 58                      		pop ax
   180                                  
   181                                  		; Check if the left edge of the ball is left of the right edge of the left paddle.
   182                                  		; if ballposx > OFFSET + WIDTH then no hit.
   183 00000072 83FE19                  		cmp si, PLAYER_PADDLE_OFFSET + PLAYER_PADDLE_WIDTH 
   184 00000075 7703                    		ja SHORT .endif_left_paddle_x
   185 00000077 E81901                  			call paddle_vertical_hit_detection
   186                                  		.endif_left_paddle_x:
   187                                  
   188                                  		; ~~~~~ RIGHT PADDLE ~~~~~
   189 0000007A 50                      		push ax
   190 0000007B 88E0                    		mov al, ah
   191 0000007D 30E4                    		xor ah, ah
   192 0000007F 89C5                    		mov bp, ax
   193 00000081 58                      		pop ax
   194                                  
   195                                  		; Check if the right edge of the ball is left of the left edge of the right paddle.
   196                                  		; if ballposx + BALLSIZEX < 319 - OFFSET - WIDTH then no hit.
   197                                  		; if ballposx < 319 - OFFSET - WIDTH - BALLSIZEX then no hit.
   198 00000082 81FE2101                		cmp si, 319 - PLAYER_PADDLE_OFFSET - PLAYER_PADDLE_WIDTH - BALL_DIM
   199 00000086 7203                    		jb SHORT .endif_right_paddle_x
   200 00000088 E80801                  			call paddle_vertical_hit_detection
   201                                  		.endif_right_paddle_x:
   202                                  
   203                                  		; ~~~~~ ROOF ~~~~~
   204 0000008B 83FF01                  		cmp di, 1
   205 0000008E 7302                    		jae SHORT .end_if_roof
   206                                  			; Flip y velocity.
   207 00000090 F6DF                    			neg bh
   208                                  		.end_if_roof:
   209                                  
   210                                  		; ~~~~~ FLOOR ~~~~~
   211 00000092 81FFC200                		cmp di, 199 - BALL_DIM
   212 00000096 7602                    		jbe SHORT .end_if_floor
   213                                  			; Flip y velocity.
   214 00000098 F6DF                    			neg bh
   215                                  		.end_if_floor:
   216                                  
   217                                  
   218                                  
   219                                  		; ~~~~~ AI PLAYER MOVEMENT ~~~~~
   220                                  		; If ball is higher than paddle, go up. Otherwise go down.
   221 0000009A 31D2                    		xor dx, dx
   222 0000009C 88E2                    		mov dl, ah
   223 0000009E 83C219                  		add dx, PLAYER_PADDLE_HEIGHT / 2
   224                                  		; Jump if paddle has a lower or equal value (is higher up) than the ball.
   225 000000A1 39FA                    		cmp dx, di
   226 000000A3 7607                    		jbe SHORT .endif_move_up	
   227                                  			; Jump if enemy paddle is at 1 (can't move up).
   228 000000A5 80FC01                  			cmp ah, 1
   229 000000A8 7602                    			jbe SHORT .endif_move_up
   230 000000AA FECC                    				dec ah
   231                                  		.endif_move_up:
   232 000000AC 31D2                    		xor dx, dx
   233 000000AE 88E2                    		mov dl, ah
   234 000000B0 83C219                  		add dx, PLAYER_PADDLE_HEIGHT / 2
   235                                  		; Jump if paddle has a higher or equal value (is lower down) than the ball.
   236 000000B3 39FA                    		cmp dx, di
   237 000000B5 7307                    		jae SHORT .endif_move_down
   238                                  			; Jump if enemy paddle is at 197 (Can't move down).
   239 000000B7 80FC94                  			cmp ah, 198 - PLAYER_PADDLE_HEIGHT
   240 000000BA 7302                    			jae SHORT .endif_move_down
   241 000000BC FEC4                    				inc ah	
   242                                  		.endif_move_down:
   243                                  
   244                                  
   245                                  		
   246                                  		; ~~~~~ RENDERING LOGIC ~~~~~
   247                                  		; Frames are rendered to a temporary memory area (0x4000), and then copied
   248                                  		; graphical memory area for 13h mode (0xA000). 
   249                                  		; This prevents tearing effects due to video updates on partially completed
   250                                  		; renders.
   251                                  
   252                                  		; Ds does not support direct mov, use a general register first.
   253                                  		; ES holds the memory segment for rendering to, direct it to a temporary
   254                                  		; area.
   255 000000BE 50                      		push ax
   256 000000BF B80040                  		mov ax, 0x4000
   257 000000C2 8EC0                    		mov es, ax
   258 000000C4 58                      		pop ax
   259                                  
   260                                  
   261                                  		; Render elements by using two for loops and jmp conditions.
   262                                  		; This is slower than rendering each element individually but saves bytes.
   263                                  		; BX, CX and DX are used as they are not needed in the rendering code.
   264 000000C5 53                      		push bx
   265 000000C6 51                      		push cx
   266 000000C7 31DB                    		xor bx, bx
   267                                  
   268                                  		.x_render_loop:
   269                                  		; For x < 320
   270 000000C9 81FB4001                		cmp bx, 320
   271 000000CD 0F839000                		jae .endif_x_render_loop
   272 000000D1 31C9                    			xor cx, cx
   273                                  			.y_render_loop:
   274                                  			; For y < 200
   275 000000D3 81F9C800                			cmp cx, 200
   276 000000D7 0F838200                			jae .endif_y_render_loop
   277                                  				; Main render loop.
   278                                  				; Assume pixel is being drawn unless found otherwise.
   279                                  				; Avoids a few mov instructions.
   280 000000DB B20F                    				mov dl, 0x0F
   281                                  
   282 000000DD 83FB00                  				cmp bx, 0
   283 000000E0 7702                    				ja SHORT .endif_left_segment
   284                                  					; Left segment.
   285 000000E2 EB68                    					jmp SHORT .endif_blank_area
   286                                  				.endif_left_segment:
   287                                  
   288 000000E4 83F900                  				cmp cx, 0
   289 000000E7 7702                    				ja SHORT .endif_top_segment
   290                                  					; Top segment.
   291 000000E9 EB61                    					jmp SHORT .endif_blank_area
   292                                  				.endif_top_segment:
   293                                  
   294 000000EB 81FB3F01                				cmp bx, 319
   295 000000EF 7202                    				jb SHORT .endif_right_segment
   296                                  					; Right segment.
   297 000000F1 EB59                    					jmp SHORT .endif_blank_area
   298                                  				.endif_right_segment:
   299                                  
   300 000000F3 81F9C700                				cmp cx, 199
   301 000000F7 7202                    				jb SHORT .endif_bottom_segment 
   302                                  					; Bottom segment.
   303 000000F9 EB51                    					jmp SHORT .endif_blank_area
   304                                  				.endif_bottom_segment:
   305                                  
   306                                  				; Left paddle.
   307                                  				; Pixel x >= Paddle x
   308 000000FB 83FB14                  				cmp bx, PLAYER_PADDLE_OFFSET
   309 000000FE 7213                    				jb SHORT .endif_lpaddle_x
   310                                  					; Pixel x <= Paddle x + Paddle width
   311 00000100 83FB19                  					cmp bx, PLAYER_PADDLE_OFFSET + PLAYER_PADDLE_WIDTH
   312 00000103 770E                    					ja SHORT .endif_lpaddle_x2
   313                                  						; Pixel y >= paddle y
   314 00000105 38C1                    						cmp cl, al
   315 00000107 720A                    						jb SHORT .endif_lpaddle_y1
   316                                  							; Pixel y <= paddle y + paddle height
   317 00000109 50                      							push ax
   318 0000010A 0432                    							add al, PLAYER_PADDLE_HEIGHT
   319 0000010C 38C1                    							cmp cl, al
   320 0000010E 58                      							pop ax
   321 0000010F 7702                    							ja SHORT .endif_lpaddle_y2
   322 00000111 EB39                    								jmp SHORT .endif_blank_area
   323                                  							.endif_lpaddle_y2:
   324                                  						.endif_lpaddle_y1:
   325                                  					.endif_lpaddle_x2:
   326                                  				.endif_lpaddle_x:
   327                                  
   328                                  				; Right paddle.
   329                                  				; Pixel x >= Paddle x
   330 00000113 81FB2601                				cmp bx, 319 - PLAYER_PADDLE_OFFSET - PLAYER_PADDLE_WIDTH
   331 00000117 7215                    				jb SHORT .endif_rpaddle_x
   332                                  					; Pixel x <= Paddle x + Paddle width
   333 00000119 81FB2B01                					cmp bx, 319 - PLAYER_PADDLE_OFFSET
   334 0000011D 770F                    					ja SHORT .endif_rpaddle_x2
   335                                  						; Pixel y >= paddle y
   336 0000011F 38E1                    						cmp cl, ah
   337 00000121 720B                    						jb SHORT .endif_rpaddle_y1
   338                                  							; Pixel y <= paddle y + paddle height
   339 00000123 50                      							push ax
   340 00000124 80C432                  							add ah, PLAYER_PADDLE_HEIGHT
   341 00000127 38E1                    							cmp cl, ah
   342 00000129 58                      							pop ax
   343 0000012A 7702                    							ja SHORT .endif_rpaddle_y2
   344 0000012C EB1E                    								jmp SHORT .endif_blank_area
   345                                  							.endif_rpaddle_y2:
   346                                  						.endif_rpaddle_y1:
   347                                  					.endif_rpaddle_x2:
   348                                  				.endif_rpaddle_x:
   349                                  
   350                                  				
   351                                  
   352                                  				; Ball rendering.
   353                                  				; Pixel x >= ballx
   354 0000012E 39F3                    				cmp bx, si
   355 00000130 7218                    				jb SHORT .endif_ball_x1
   356                                  					; Pixel x <= ballx + ball width
   357 00000132 56                      					push si
   358 00000133 83C605                  					add si, BALL_DIM
   359 00000136 39F3                    					cmp bx, si
   360 00000138 5E                      					pop si
   361 00000139 770F                    					ja SHORT .endif_ball_x2
   362                                  						; Pixel y >= ball y
   363 0000013B 39F9                    						cmp cx, di
   364 0000013D 720B                    						jb SHORT .endif_ball_y1
   365                                  							; Pixel y <= ball y + ball height
   366 0000013F 57                      							push di
   367 00000140 83C705                  							add di, BALL_DIM
   368 00000143 39F9                    							cmp cx, di
   369 00000145 5F                      							pop di
   370 00000146 7702                    							ja SHORT .endif_ball_y2
   371 00000148 EB02                    								jmp SHORT .endif_blank_area
   372                                  							.endif_ball_y2:
   373                                  						.endif_ball_y1:
   374                                  					.endif_ball_x2:
   375                                  				.endif_ball_x1:
   376                                  
   377                                  				; ELSE
   378                                  				; Otherwise draw blank pixel.
   379 0000014A B200                    				mov dl, 0x00 
   380                                  
   381                                  				.endif_blank_area:
   382                                  
   383                                  				; Draw calculated pixel to rendering area.
   384 0000014C 56                      				push si 
   385 0000014D 89CE                    				mov si, cx
   386 0000014F 69F64001                				imul si, SCREEN_WIDTH
   387 00000153 01DE                    				add si, bx
   388 00000155 268814                  				mov BYTE [es:si], dl
   389 00000158 5E                      				pop si
   390                                  
   391 00000159 41                      				inc cx
   392 0000015A E976FF                  				jmp .y_render_loop 
   393                                  
   394                                  			.endif_y_render_loop:
   395                                  
   396 0000015D 43                      			inc bx
   397 0000015E E968FF                  			jmp .x_render_loop
   398                                  
   399                                  		.endif_x_render_loop:
   400                                  
   401 00000161 59                      		pop cx
   402 00000162 5B                      		pop bx
   403                                  
   404                                  
   405                                  		; Copy render over to actuall video memory area. (flip).
   406 00000163 60                      		pusha
   407 00000164 FC                      		cld
   408                                  		; Set ds to source memory area
   409 00000165 06                      		push es
   410 00000166 1F                      		pop ds 
   411                                  		; Set es to destination memory area
   412 00000167 B800A0                  		mov ax, 0xA000
   413 0000016A 8EC0                    		mov es, ax
   414                                  
   415                                  		; Clear indexes and copy memory over.
   416 0000016C 31F6                    		xor si, si
   417 0000016E 31FF                    		xor di, di
   418 00000170 B9007D                  		mov cx, RANGE
   419 00000173 F3A5                    		rep movsw
   420 00000175 61                      		popa
   421                                  		
   422                                  		; Limit fps to 60 using bios wait interupts.
   423 00000176 60                      		pusha
   424 00000177 B90000                  		mov  cx, 0
   425 0000017A BA1B41                     		mov  dx, 16667  
   426 0000017D B486                        	mov  ah, 86h
   427 0000017F CD15                        	int  15h
   428 00000181 61                      		popa
   429                                  
   430 00000182 E99DFE                  		jmp .game_loop
   431                                  	 
   432                                  
   433                                  ; Ball velocity starts at a random number from -3 - 3 (not 0) for both x and y.
   434                                  ; Generates to  register.
   435                                  gen_rand_velocity:
   436                                  	; Read byte from timer, psuedo-random byte.
   437 00000185 E440                    	in al, 0x40
   438                                  
   439                                  	; Multiply al by 6 and put it into ax.
   440                                  	; overflow causes ah to be in the range 0-5.	
   441 00000187 B306                    	mov bl, 6
   442 00000189 F6E3                    	mul bl
   443                                  
   444                                  	; Shift the range 0-5 to -3 to 2. 
   445 0000018B 80EC03                  	sub ah, 3
   446                                  
   447                                  	; Flip the cf flag and add it back to ah.
   448                                  	; cf is 1 for positive results (0, 1, 2),
   449                                  	; range becomes -3 - -1 and 1 - 3 .
   450 0000018E F5                      	cmc
   451 0000018F 80D400                  	adc ah, 0
   452                                  
   453 00000192 C3                      	ret
   454                                  
   455                                  
   456                                  
   457                                  ; General hit detection for the vertical portion of a paddle.
   458                                  ; Paddle y position should be stored in bp register as input.
   459                                  ; No output.
   460                                  paddle_vertical_hit_detection:
   461                                  	; Check if the ball is below the top edge of the paddle.
   462 00000193 31D2                    	xor dx, dx
   463 00000195 89EA                    	mov dx, bp
   464 00000197 83EA05                  	sub dx, BALL_DIM
   465 0000019A 39D7                    	cmp di, dx
   466 0000019C 761D                    	jbe SHORT .endif_paddle_y1
   467                                  		; Check if the ball is above the bottom edge of the paddle.
   468 0000019E 31D2                    		xor dx, dx
   469 000001A0 89EA                    		mov dx, bp
   470 000001A2 83C232                  		add dx, PLAYER_PADDLE_HEIGHT
   471 000001A5 39D7                    		cmp di, dx
   472 000001A7 7312                    		jae SHORT .endif_paddle_y2
   473                                  			; Ball is hitting the paddle. 
   474                                  			; Invert y velocity then
   475                                  			; Increment both vertical and horizontal velocity 
   476                                  			; in whatever direction its heading.
   477 000001A9 08FF                    			or bh, bh
   478 000001AB 7902                    			jns SHORT .endif_left_dec1
   479 000001AD FECF                    				dec bh
   480                                  			.endif_left_dec1:
   481 000001AF FEC7                    			inc bh
   482                                  
   483 000001B1 F6DB                    			neg bl
   484 000001B3 08DB                    			or bl, bl
   485 000001B5 7902                    			jns SHORT .endif_left_dec2
   486 000001B7 FECB                    				dec bl
   487                                  			.endif_left_dec2:
   488 000001B9 FEC3                    			inc bl
   489                                  		.endif_paddle_y2:
   490                                  	.endif_paddle_y1:
   491 000001BB C3                      	ret
   492                                  
   493                                  
   494                                  
   495                                  ; cl should store score.
   496                                  ; si x position (text rows)
   497                                  ; di y position (text cols)
   498                                  show_score_single:
   499                                  	; Move cursor to (si, di) position.
   500                                  	; Page 0.
   501 000001BC 30FF                    	xor bh, bh
   502                                  	; Bright white palette
   503 000001BE B30F                    	mov bl, 15
   504                                  	; DH = row, DL = col
